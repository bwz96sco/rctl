{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rctl result frontmatter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "contract_revision", "assessment"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "contract_revision": {"type": "integer", "minimum": 1},
    "assessment": {"enum": ["supported", "not_supported", "inconclusive", "not_applicable"]}
  }
}
