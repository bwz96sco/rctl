{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rctl review input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "contract_revision", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "contract_revision": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "verdict", "reviewer", "rationale", "evidence_refs"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^AC-[0-9]{2,}$"},
          "verdict": {"enum": ["pass", "fail", "unknown"]},
          "reviewer": {"enum": ["agent", "operator"]},
          "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
        }
      }
    }
  }
}
